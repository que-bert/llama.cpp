#version 450

// Prefill flash attention for RDNA4 (coopmat1 16x16x16 f16 -> f32), HSK = HSV = 256.
// Variant of flash_attn_prefill_rdna4.comp (same work decomposition, same f32 softmax and
// accumulation order) with V staged TRANSPOSED in LDS.
//
// One workgroup owns one KV head and PQ = 16 query positions of all G q heads that
// share it: rows = 16*G, row tile t = q head (kvh*G + t), 16 consecutive positions.
// Each K/V tile (Bc = 32) is staged once into LDS and used by all G heads.
// Waves: 2 per row tile. QK: wave (t, c) computes S[t][:, 16c .. 16c+15].
// PV: wave (t, h) owns O[t][:, 128h .. 128h+127] as 8 f32 accumulators that stay in
// registers across all KV tiles (online softmax; rescale via element-wise ops).
//
// V layout: sVt[d][kv] with two consecutive kv packed per uint. The PV B fragment (k = kv,
// n = d) is then a column-major load with 16 contiguous bytes per lane. The base kernel keeps
// V row-major and ACO lowers each B fragment to 8 strided ds_load_u16 per lane (128 per lane
// per KV tile). Kill: GGML_VK_NO_FA_PREFILL_RDNA4_VT=1.

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint WG = 384;   // 64 * G
layout(constant_id = 1) const uint G  = 6;     // q heads per KV head
layout(constant_id = 2) const uint DIAG = 0;  // diagnostics only: 1 no QK MMA, 2 no PV MMA, 4 no K/V/mask global loads after tile 0

const uint D   = 256;
const uint BC  = 32;
const uint PQ  = 16;
const uint NW  = WG / 32;                      // waves (2 per row tile)
const uint KSTR = 34;                          // uvec4 per staged K/Q row (32 + 2 pad)
const uint VSTR = BC / 2 + 2;                  // uint per transposed V row (BC halves + 4 pad)
const uint SSTR = 9;                           // vec4 per S row (32 + 4 pad floats)
const uint PSTR = 5;                           // uvec4 per P row (32 + 8 pad halves)
const uint NLK = (BC * 32 + WG - 1) / WG;      // K uvec4 loads per thread per tile
const uint NLV = (BC / 2 * 32 + WG - 1) / WG;  // V row-pair items (2 uvec4) per thread per tile
const uint NML = (PQ * BC / 2 + WG - 1) / WG;  // mask half2 loads per thread per tile

layout(push_constant) uniform parameter {
    uint N; uint KV; uint nhq;
    uint q_s1; uint q_s2; uint q_s3;           // floats
    uint k_s1; uint k_s2; uint k_s3;           // uvec4 (8 halves)
    uint v_s1; uint v_s2; uint v_s3;
    uint m_s1; uint m_s3; uint has_mask; uint nem3;
    float scale;
} p;

layout(binding = 0) readonly buffer Q { vec4 data_q[]; };
layout(binding = 1) readonly buffer K { uvec4 data_k[]; };
layout(binding = 2) readonly buffer V { uvec4 data_v[]; };
layout(binding = 3) readonly buffer M { float16_t data_m[]; };
layout(binding = 4) writeonly buffer O { float data_o[]; };

shared uvec4 sK[BC * KSTR];                    // K tile (also Q staging, 2 row tiles at a time)
shared uint  sVt[D * VSTR];                    // V tile transposed: [d][kv], 2 kv per uint
shared vec4  sS[16 * G * SSTR];                // S = Q K^T, f32
shared uvec4 sP[16 * G * PSTR];                // P, f16
shared vec4  sA[G * 64];                       // per row tile 16x16 broadcast of row factor
shared float16_t sM[PQ * BC];                  // mask tile
shared uint  sR[NW];                           // per-wave "row max changed"

#define MATA  coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MATB  coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define MATC  coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint wave = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint t    = wave >> 1;               // row tile = q head within the group
    const uint half_ = wave & 1;               // QK: column tile
    const uint pt0  = (wave >> 2) * 2;         // PV: row-tile pair (needs G even)
    const uint pq   = wave & 3;                // PV: hsv quarter (64 columns)

    const uint p0   = gl_WorkGroupID.x * PQ;
    const uint kvh  = gl_WorkGroupID.y;
    const uint iq3  = gl_WorkGroupID.z;
    const uint N = p.N, KV = p.KV;

    const uint k_base = iq3 * p.k_s3 + kvh * p.k_s2;
    const uint v_base = iq3 * p.v_s3 + kvh * p.v_s2;
    const uint m_base = (iq3 % p.nem3) * p.m_s3;
    const bool has_mask = p.has_mask != 0;

    // ---- Q: f32 global -> f16 LDS (2 row tiles per chunk) -> registers
    MATA Qf[16];
    for (uint t0 = 0; t0 < G; t0 += 2) {
        [[unroll]] for (uint i = 0; i < (32 * 32 + WG - 1) / WG; ++i) {
            const uint e = tid + i * WG;
            if (e < 32 * 32) {
                const uint rr = e >> 5, c = e & 31;
                const uint tt = t0 + (rr >> 4), pos = p0 + (rr & 15);
                uvec4 w = uvec4(0);
                if (tt < G && pos < N) {
                    const uint qo = (iq3 * p.q_s3 + (kvh * G + tt) * p.q_s2 + pos * p.q_s1) / 4 + c * 2;
                    const vec4 a = data_q[qo], b = data_q[qo + 1];
                    w = uvec4(packFloat2x16(f16vec2(a.xy)), packFloat2x16(f16vec2(a.zw)),
                              packFloat2x16(f16vec2(b.xy)), packFloat2x16(f16vec2(b.zw)));
                }
                sK[rr * KSTR + c] = w;
            }
        }
        barrier();
        if (t >= t0 && t < t0 + 2) {
            [[unroll]] for (uint k = 0; k < 16; ++k) {
                coopMatLoad(Qf[k], sK, ((t - t0) * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();
    }

    MATC Oacc[8];
    [[unroll]] for (uint i = 0; i < 8; ++i) Oacc[i] = MATC(0.0);

    // softmax ownership: 4 threads per row, 8 columns each
    const uint sr  = tid >> 2;                 // row 0 .. 16G-1
    const uint sq  = tid & 3;
    const uint slr = sr & 15;
    const uint st  = sr >> 4;
    float m_i = -1.0e30;
    float l_i = 0.0;

    const uint nj = (KV + BC - 1) / BC;

    uvec4 prk[NLK];
    uvec4 prv[NLV][2];
    float16_t pm[NML][2];

// Prefetch loads are unconditional with clamped indices: a "x = 0; if (in range) x = load" form
// makes ACO wait for each load right away (the else-path write is a WAW on the load's VGPRs), which
// serialized the register prefetch in the base kernel. Out-of-range K/V rows read row KV-1 (finite;
// their columns are masked to -inf, so P = 0); out-of-range mask entries are fixed up at staging.
#define PREFETCH_K(j) { \
        const uint kv0_ = (j) * BC; \
        [[unroll]] for (uint i = 0; i < NLK; ++i) { \
            const uint e = min(tid + i * WG, BC * 32 - 1); \
            const uint rr = min(kv0_ + (e >> 5), KV - 1), c = e & 31; \
            prk[i] = data_k[k_base + rr * p.k_s1 + c]; \
        } \
    }

#define STAGE_K { \
        [[unroll]] for (uint i = 0; i < NLK; ++i) { \
            const uint e = tid + i * WG; \
            if (e < BC * 32) { \
                const uint rr = e >> 5, c = e & 31; \
                sK[rr * KSTR + c] = prk[i]; \
            } \
        } \
    }


#define PREFETCH_V(j) { \
        const uint kv0_ = (j) * BC; \
        [[unroll]] for (uint i = 0; i < NLV; ++i) { \
            const uint e = min(tid + i * WG, BC / 2 * 32 - 1); \
            const uint r2 = kv0_ + (e >> 5) * 2, c = e & 31; \
            prv[i][0] = data_v[v_base + min(r2,     KV - 1) * p.v_s1 + c]; \
            prv[i][1] = data_v[v_base + min(r2 + 1, KV - 1) * p.v_s1 + c]; \
        } \
    }

#define PREFETCH_M(j) { \
        const uint kv0_ = (j) * BC; \
        [[unroll]] for (uint i = 0; i < NML; ++i) { \
            const uint e = min(tid + i * WG, PQ * BC / 2 - 1); \
            const uint pos = min(p0 + (e >> 4), N - 1), c = kv0_ + (e & 15) * 2; \
            const uint mb = m_base + pos * p.m_s1; \
            pm[i][0] = data_m[has_mask ? mb + min(c,     KV - 1) : 0]; \
            pm[i][1] = data_m[has_mask ? mb + min(c + 1, KV - 1) : 0]; \
        } \
    }

#define STAGE_V { \
        [[unroll]] for (uint i = 0; i < NLV; ++i) { \
            const uint e = tid + i * WG; \
            if (e < BC / 2 * 32) { \
                const uint r = e >> 5, c = e & 31; \
                const uvec4 a = prv[i][0], b = prv[i][1]; \
                /* d = 8c + 2w + h: low half from kv row 2r, high half from row 2r + 1 */ \
                [[unroll]] for (uint w = 0; w < 4; ++w) { \
                    sVt[(c * 8 + 2 * w)     * VSTR + r] = (a[w] & 0xFFFFu) | (b[w] << 16); \
                    sVt[(c * 8 + 2 * w + 1) * VSTR + r] = (a[w] >> 16) | (b[w] & 0xFFFF0000u); \
                } \
            } \
        } \
    }

#define STAGE_M(j) { \
        [[unroll]] for (uint i = 0; i < NML; ++i) { \
            const uint e = tid + i * WG; \
            if (e < PQ * BC / 2) { \
                const uint c = (j) * BC + (e & 15) * 2; \
                const bool prow = p0 + (e >> 4) < N; \
                const float16_t ninf = float16_t(-1.0/0.0); \
                sM[e * 2]     = (prow && c     < KV) ? (has_mask ? pm[i][0] : float16_t(0.0)) : ninf; \
                sM[e * 2 + 1] = (prow && c + 1 < KV) ? (has_mask ? pm[i][1] : float16_t(0.0)) : ninf; \
            } \
        } \
    }

    // Software-pipelined schedule, 2 barriers per KV tile:
    //   A(j): softmax(j) [sS, sM -> sP, sA, sR]; stage K(j+1) -> sK, V(j) -> sVt
    //   B(j): O = diag(alpha) O + P V(j), interleaved with S(j+1) = Q K(j+1)^T -> sS;
    //         stage mask(j+1) -> sM
    // QK is one 16-deep dependent WMMA chain per wave; sharing a phase with the 16 independent
    // PV WMMAs hides its latency. No fully-masked-tile skip: a -inf tile gives P = 0, alpha = 1.
    // At the last tile, B computes a discarded S from stale sK (all indices stay in range).
    PREFETCH_K(0)
    PREFETCH_M(0)
    STAGE_K
    STAGE_M(0)
    PREFETCH_K(1)
    PREFETCH_V(0)
    PREFETCH_M(1)
    barrier();
    {
        MATC Sacc = MATC(0.0);
        [[unroll]] for (uint k = 0; k < 16; ++k) {
            MATB Kf;
            coopMatLoad(Kf, sK, (half_ * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutColumnMajor);
            Sacc = coopMatMulAdd(Qf[k], Kf, Sacc);
        }
        coopMatStore(Sacc, sS, (t * 16) * SSTR + half_ * 4, SSTR, gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();

    for (uint j = 0; j < nj; ++j) {
        // ---- A(j): online softmax, f32
        {
            const vec4 a = sS[sr * SSTR + sq * 2];
            const vec4 b = sS[sr * SSTR + sq * 2 + 1];
            float s[8] = float[8](a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w);
            float mx = -1.0/0.0;
            [[unroll]] for (uint e = 0; e < 8; ++e) {
                s[e] = s[e] * p.scale + float(sM[slr * BC + sq * 8 + e]);
                mx = max(mx, s[e]);
            }
            mx = max(mx, subgroupShuffleXor(mx, 1));
            mx = max(mx, subgroupShuffleXor(mx, 2));
            const float m_new = max(m_i, mx);
            float rs = 0.0;
            f16vec2 ph[4];
            [[unroll]] for (uint e = 0; e < 4; ++e) {
                const float e0 = exp(s[2 * e] - m_new);
                const float e1 = exp(s[2 * e + 1] - m_new);
                rs += e0 + e1;
                ph[e] = f16vec2(e0, e1);
            }
            rs += subgroupShuffleXor(rs, 1);
            rs += subgroupShuffleXor(rs, 2);
            const float alpha = exp(m_i - m_new);
            l_i = l_i * alpha + rs;
            m_i = m_new;
            sP[sr * PSTR + sq] = uvec4(packFloat2x16(ph[0]), packFloat2x16(ph[1]),
                                       packFloat2x16(ph[2]), packFloat2x16(ph[3]));
            sA[st * 64 + slr * 4 + sq] = vec4(alpha);
            const bool resc = subgroupAny(alpha != 1.0);
            if (lane == 0) sR[wave] = resc ? 1u : 0u;
        }
        STAGE_K
        STAGE_V
        if ((DIAG & 4) == 0) {
            PREFETCH_K(j + 2)
            PREFETCH_V(j + 1)
        }
        barrier();

        // ---- B(j): rescale, PV(j) for row tiles (pt0, pt0+1) x hsv quarter pq, and QK(j+1)
        [[unroll]] for (uint r = 0; r < 2; ++r) {
            const uint tr = pt0 + r;
            if ((sR[2 * tr] | sR[2 * tr + 1]) != 0) {
                MATC Am;
                coopMatLoad(Am, sA, tr * 64, 4, gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint i = 0; i < 4; ++i) Oacc[r * 4 + i] = Oacc[r * 4 + i] * Am;
            }
        }
        {
            MATC Sacc = MATC(0.0);
            [[unroll]] for (uint kk = 0; kk < 2; ++kk) {
                MATA Pf0, Pf1;
                coopMatLoad(Pf0, sP, (pt0 * 16) * PSTR + kk * 2, PSTR, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(Pf1, sP, (pt0 * 16 + 16) * PSTR + kk * 2, PSTR, gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint i = 0; i < 4; ++i) {
                    MATB Vf;
                    coopMatLoad(Vf, sVt, (pq * 64 + i * 16) * VSTR + kk * 8, VSTR, gl_CooperativeMatrixLayoutColumnMajor);
                    if ((DIAG & 2) == 0) {
                        Oacc[i]     = coopMatMulAdd(Pf0, Vf, Oacc[i]);
                        Oacc[4 + i] = coopMatMulAdd(Pf1, Vf, Oacc[4 + i]);
                    }
                    [[unroll]] for (uint h = 0; h < 2; ++h) {
                        const uint k = kk * 8 + i * 2 + h;
                        MATB Kf;
                        coopMatLoad(Kf, sK, (half_ * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutColumnMajor);
                        if ((DIAG & 1) == 0) Sacc = coopMatMulAdd(Qf[k], Kf, Sacc);
                    }
                }
            }
            coopMatStore(Sacc, sS, (t * 16) * SSTR + half_ * 4, SSTR, gl_CooperativeMatrixLayoutRowMajor);
        }
        STAGE_M(j + 1)
        if ((DIAG & 4) == 0) PREFETCH_M(j + 2)
        barrier();
    }

    // ---- normalize by l and store
    sA[st * 64 + slr * 4 + sq] = vec4(l_i > 0.0 ? 1.0 / l_i : 0.0);
    barrier();
    const uint o_row = p.nhq * D;
    [[unroll]] for (uint r = 0; r < 2; ++r) {
    MATC Lm;
    coopMatLoad(Lm, sA, (pt0 + r) * 64, 4, gl_CooperativeMatrixLayoutRowMajor);
    const uint head = kvh * G + pt0 + r;
    const uint o_base = (iq3 * N + p0) * o_row + head * D + pq * 64;
    if (p0 + PQ <= N) {
        [[unroll]] for (uint i = r * 4; i < r * 4 + 4; ++i) {
            Oacc[i] = Oacc[i] * Lm;
            coopMatStore(Oacc[i], data_o, o_base + (i & 3) * 16, o_row, gl_CooperativeMatrixLayoutRowMajor);
        }
    } else {
        // partial position block: stage each 16x16 through a per-wave LDS slot
        const uint slot = wave * 64;           // 64 vec4 = 256 floats per wave (sS is free now)
        [[unroll]] for (uint i = r * 4; i < r * 4 + 4; ++i) {
            Oacc[i] = Oacc[i] * Lm;
            coopMatStore(Oacc[i], sS, slot, 4, gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            for (uint e = lane; e < 256; e += 32) {
                const uint rr = e >> 4, c = e & 15;
                if (p0 + rr < N) {
                    data_o[o_base + rr * o_row + (i & 3) * 16 + c] = sS[slot + rr * 4 + (c >> 2)][c & 3];
                }
            }
            subgroupBarrier();
        }
    }
    }
}
