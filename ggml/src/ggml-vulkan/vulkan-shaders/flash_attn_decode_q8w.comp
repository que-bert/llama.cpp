#version 450

// Decode flash attention for q8_0 K and V, HSK == HSV == 256, few query
// positions, grouped-query attention, register-fed coopmat (RDNA4 / RADV only).
//
// q8w = flash_attn_decode_q8r.comp reshaped for occupancy: 8 waves of 32 per
// workgroup instead of 4, so each wave owns 32 output d (2 d-tiles) instead of
// 64, halving the O accumulator; V is loaded per 16-row PV step instead of all
// 64 rows before the softmax; Q, P and the row maxima keep only ROWS rows in
// LDS (the second 16-row tile of a 17..32-row group is the overlapping tile
// ROWS-16 .. ROWS-1, so no padding rows exist anywhere).
//
// Coopmat element layout, RADV 26.0 gfx1201 wave32, 16x16 (probed with
// perf-lab harness/wmma_peak --layout):
//   A   (row m, col k): lane l holds m = l%16, k = 8*(l/16) + i, i = 0..7
//   B   (row k, col n): lane l holds n = l%16, k = 8*(l/16) + i
//   Acc (row m, col n): lane l holds n = l%16, m = 8*(l/16) + i
//
// Per iteration 128 kv rows:
//  QK : wave w computes S for kv rows j0+16w .. +15 over all of d, with the
//       permuted d order of q8r (lane half h reads one contiguous 136-byte
//       half row of K; k-step t, half h holds d = 128h + 8t + i).
//  softmax: row max via clustered max + LDS across the 8 waves; each wave
//       keeps its own partial row sum.
//  PV : wave w owns d in [32w, 32w+32) = q8_0 block w. Per 16-row step the
//       lane loads, for each of its 8 kv rows, the u16 of qs bytes 2c, 2c+1
//       and the block scale; d-tile T, lane column c holds d = 32w + 2c + T.
// Writes the unnormalised partial (O, L, M) in the fa_split_k_reduce layout.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_clustered : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

layout (constant_id = 0) const uint G = 6;   // query heads per KV head
layout (constant_id = 1) const uint P = 4;   // query positions per workgroup
const uint ROWS = G * P;
#ifndef RT
#define RT 2                                 // 16-row tiles (ROWS <= 16*RT)
#endif
#if RT == 1
const uint QR = 16;                          // rows kept in LDS
#else
const uint QR = ROWS;                        // host guarantees 17..32
#endif
const uint D   = 256;
const uint BC  = 128;                        // kv rows per iteration
const uint NW  = 8;                          // waves
const uint QST = 264;                        // Q LDS row stride (f16)
const uint PST = 136;                        // P LDS row stride (f16)

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer Q   { vec4 data_q4[]; };
layout (binding = 1) readonly buffer K2  { uvec2 data_k2[]; };
layout (binding = 2) readonly buffer V   { uint16_t data_v16[]; };
layout (binding = 3) readonly buffer M   { float16_t data_m[]; };
layout (binding = 4) writeonly buffer O  { float data_o[]; };
layout (binding = 4) writeonly buffer O2 { vec2 data_o2[]; };

layout (push_constant) uniform parameter {
    uint N;          // query positions
    uint KV;
    uint n_head;     // dst ne1 (query heads)
    uint has_mask;
    uint q_s1;       // Q stride between positions, in vec4
    uint q_s2;       // Q stride between heads, in vec4
    uint k_s1;       // K stride between kv rows, bytes
    uint k_s2;       // K stride between kv heads, bytes
    uint v_s1;
    uint v_s2;
    uint m_s1;       // mask stride between positions, f16 elements
    float scale;
    uint split_kv;
    uint k_num;
    uint n_kv_head;
} p;

shared f16vec4 Qsh[QR * QST / 4];
shared f16vec4 Psh[QR * PST / 4];
shared float   Msh[NW][QR];

#define NEG_FLT_MAX_OVER_2 uintBitsToFloat(0xFEFFFFFF)
#define NEG_INF uintBitsToFloat(0xFF800000)

// q ^ 0x80 bytes -> f16 pairs, exact: 0x64XX as f16 is 1024 + XX.
f16vec2 q8pair(uint lo, uint hi) {
    return unpackFloat2x16((lo & 0xFFu) | ((hi & 0xFFu) << 16) | 0x64006400u) - f16vec2(1152.0hf);
}

// first LDS row of 16-row tile rt
uint tbase(uint rt) { return rt == 0 ? 0 : QR - 16; }

void main() {
    const uint tid   = gl_LocalInvocationID.x;
    const uint w     = tid / 32;
    const uint lane  = tid % 32;
    const uint c     = lane % 16;
    const uint hh    = lane / 16;
    const uint hkv   = gl_WorkGroupID.x % p.n_kv_head;
    const uint split = gl_WorkGroupID.x / p.n_kv_head;
    const uint p0    = gl_WorkGroupID.z * P;

    // ---- Q -> LDS, f16, permuted: column 16t + 8h + i holds d = 128h + 8t + i ----
    for (uint idx = tid; idx < QR * (D / 4); idx += 256) {
        const uint r   = idx / (D / 4);
        const uint col = (idx % (D / 4)) * 4;
        const uint d   = 128 * ((col % 16) / 8) + 8 * (col / 16) + col % 8;
        const uint pos = p0 + r / G;
        vec4 v = vec4(0);
        if (r < ROWS && pos < p.N) {
            v = data_q4[pos * p.q_s1 + (hkv * G + r % G) * p.q_s2 + d / 4];
        }
        Qsh[(r * QST + col) / 4] = f16vec4(v);
    }
    barrier();

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Oacc[RT][2];
    [[unroll]] for (uint t = 0; t < RT; ++t) {
        [[unroll]] for (uint T = 0; T < 2; ++T) Oacc[t][T] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }
    float mrow[RT][8];
    float lrow[RT][8];
    [[unroll]] for (uint t = 0; t < RT; ++t) {
        [[unroll]] for (uint i = 0; i < 8; ++i) { mrow[t][i] = NEG_FLT_MAX_OVER_2; lrow[t][i] = 0.0; }
    }

    const uint kv_begin = split * p.split_kv;
    const uint kv_end   = min(p.KV, kv_begin + p.split_kv);
    const uint kbase    = hkv * p.k_s2;
    const uint vbase    = hkv * p.v_s2;
    const uint vq_off   = 34 * w + 2 + 2 * c;    // bytes, inside the row
    const uint vs_off   = 34 * w;

    for (uint j0 = kv_begin; j0 < kv_end; j0 += BC) {
        // ---- K: half row (136 bytes) of kv row j0 + 16w + c ----
        const uint jk = j0 + 16 * w + c;
        uint kw[34];
        {
            const uint kb = (kbase + min(jk, kv_end - 1) * p.k_s1 + 136 * hh) / 8;
            [[unroll]] for (uint e = 0; e < 17; ++e) {
                const uvec2 v = data_k2[kb + e];
                kw[2 * e] = v.x; kw[2 * e + 1] = v.y;
            }
        }

        // mask for this lane's kv column, loaded right after K so the wait
        // for it does not also wait for loads issued later
        float mk[P];
        {
            const bool jin = jk < kv_end;
            const uint jm = min(jk, kv_end - 1);
            [[unroll]] for (uint pl = 0; pl < P; ++pl) {
                const uint pos = min(p0 + pl, p.N - 1);
                // unconditional load (index 0 when there is no mask) so ACO does not
                // wait for every outstanding load at a branch merge
                const float mload = float(data_m[p.has_mask != 0 ? pos * p.m_s1 + jm : 0]);
                mk[pl] = p.has_mask != 0 ? mload : 0.0;
                mk[pl] = jin ? mk[pl] : NEG_INF;
            }
        }

        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Sacc[RT];
        [[unroll]] for (uint t = 0; t < RT; ++t) Sacc[t] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        [[unroll]] for (uint b = 0; b < 4; ++b) {
            const uint so = 34 * b;
            const float16_t sc = (so % 4 == 0) ? unpackFloat2x16(kw[so / 4]).x : unpackFloat2x16(kw[so / 4]).y;
            const f16vec2 sc2 = f16vec2(sc);
            [[unroll]] for (uint tt = 0; tt < 4; ++tt) {
                const uint t = 4 * b + tt;
                const uint o = 34 * b + 2 + 8 * tt;
                uint q0, q1;
                if (o % 4 == 0) {
                    q0 = kw[o / 4]; q1 = kw[o / 4 + 1];
                } else {
                    q0 = (kw[o / 4] >> 16) | (kw[o / 4 + 1] << 16);
                    q1 = (kw[o / 4 + 1] >> 16) | (kw[o / 4 + 2] << 16);
                }
                q0 ^= 0x80808080u; q1 ^= 0x80808080u;
                const f16vec2 e0 = q8pair(q0, q0 >> 8) * sc2;
                const f16vec2 e1 = q8pair(q0 >> 16, q0 >> 24) * sc2;
                const f16vec2 e2 = q8pair(q1, q1 >> 8) * sc2;
                const f16vec2 e3 = q8pair(q1 >> 16, q1 >> 24) * sc2;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> kbm;
                kbm[0] = e0.x; kbm[1] = e0.y; kbm[2] = e1.x; kbm[3] = e1.y;
                kbm[4] = e2.x; kbm[5] = e2.y; kbm[6] = e3.x; kbm[7] = e3.y;
                [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> qa;
                    coopMatLoad(qa, Qsh, (tbase(rt) * QST + 16 * t) / 4, QST / 4, gl_CooperativeMatrixLayoutRowMajor);
                    Sacc[rt] = coopMatMulAdd(qa, kbm, Sacc[rt]);
                }
            }
        }

        // ---- scale + mask, row max ----
        [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
            [[unroll]] for (uint i = 0; i < 8; ++i) {
                const uint r  = tbase(rt) + 8 * hh + i;
                const uint r0 = tbase(rt) + i;
                const uint r1 = tbase(rt) + 8 + i;
                const float mv = hh == 0 ? mk[min(r0 / G, P - 1)] : mk[min(r1 / G, P - 1)];
                const float sv = Sacc[rt][i] * p.scale + mv;
                Sacc[rt][i] = sv;
                const float mx = subgroupClusteredMax(sv, 16);
                if (c == 0) Msh[w][r] = mx;
            }
        }
        barrier();

        // ---- online softmax, P -> LDS ----
        bool rescale = false;
        float alpha[RT][8];
        [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
            [[unroll]] for (uint i = 0; i < 8; ++i) {
                const uint r = tbase(rt) + 8 * hh + i;
                float mnew = mrow[rt][i];
                [[unroll]] for (uint ww = 0; ww < NW; ++ww) mnew = max(mnew, Msh[ww][r]);
                alpha[rt][i] = exp(mrow[rt][i] - mnew);
                rescale = rescale || (mnew != mrow[rt][i]);
                mrow[rt][i] = mnew;
                const float pv = exp(Sacc[rt][i] - mnew);
                Sacc[rt][i] = pv;
                lrow[rt][i] = fma(lrow[rt][i], alpha[rt][i], subgroupClusteredAdd(pv, 16));
            }
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> pf =
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(Sacc[rt]);
            coopMatStore(pf, Psh, (tbase(rt) * PST + 16 * w) / 4, PST / 4, gl_CooperativeMatrixLayoutRowMajor);
        }
        if (subgroupAny(rescale)) {
            [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
                [[unroll]] for (uint T = 0; T < 2; ++T) {
                    [[unroll]] for (uint i = 0; i < 8; ++i) Oacc[rt][T][i] *= alpha[rt][i];
                }
            }
        }
        barrier();

        // ---- PV, V loaded per 16-row step ----
        const uint vlane = vbase + (j0 + 8 * hh) * p.v_s1;
        const uint vlast = vbase + (kv_end - 1) * p.v_s1;
        [[unroll]] for (uint s = 0; s < BC / 16; ++s) {
            uint x[8];
            f16vec2 sc[4];
            [[unroll]] for (uint i = 0; i < 8; i += 2) {
                const uint vr0 = min(vlane + (16 * s + i) * p.v_s1, vlast);
                const uint vr1 = min(vlane + (16 * s + i + 1) * p.v_s1, vlast);
                x[i]     = uint(data_v16[(vr0 + vq_off) / 2]) ^ 0x8080u;
                x[i + 1] = uint(data_v16[(vr1 + vq_off) / 2]) ^ 0x8080u;
                sc[i / 2] = f16vec2(uint16BitsToHalf(data_v16[(vr0 + vs_off) / 2]), uint16BitsToHalf(data_v16[(vr1 + vs_off) / 2]));
            }
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> pa[RT];
            [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
                coopMatLoad(pa[rt], Psh, (tbase(rt) * PST + 16 * s) / 4, PST / 4, gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint T = 0; T < 2; ++T) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> vbm;
                [[unroll]] for (uint i = 0; i < 8; i += 2) {
                    const f16vec2 e = q8pair(x[i] >> (8 * T), x[i + 1] >> (8 * T)) * sc[i / 2];
                    vbm[i] = e.x; vbm[i + 1] = e.y;
                }
                [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
                    Oacc[rt][T] = coopMatMulAdd(pa[rt], vbm, Oacc[rt][T]);
                }
            }
        }
    }

    // ---- partial sums of l across waves (reuse Msh) ----
    barrier();
    [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            if (c == 0) Msh[w][tbase(rt) + 8 * hh + i] = lrow[rt][i];
        }
    }
    barrier();

    // ---- write the partial in fa_split_k_reduce layout ----
    // tile rt > 0 writes only its rows >= 16 (the rest duplicate tile 0)
    [[unroll]] for (uint rt = 0; rt < RT; ++rt) {
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            const uint r = tbase(rt) + 8 * hh + i;
            const uint pos = p0 + r / G;
            if (r < ROWS && pos < p.N && (rt == 0 || r >= 16)) {
                const uint n = hkv * G + r % G;
                const uint ob = D * p.n_head * (split + p.k_num * pos) + D * n;
                data_o2[(ob + 32 * w + 2 * c) / 2] = vec2(Oacc[rt][0][i], Oacc[rt][1][i]);
                if (w == 0 && c == 0) {
                    float lsum = 0.0;
                    [[unroll]] for (uint ww = 0; ww < NW; ++ww) lsum += Msh[ww][r];
                    const uint lb = D * p.n_head * p.N * p.k_num + p.n_head * 2 * (split + p.k_num * pos) + n;
                    data_o[lb] = lsum;
                    data_o[lb + p.n_head] = mrow[rt][i];
                }
            }
        }
    }
}
