#version 450

// Prefill flash attention for RDNA4 (coopmat1 16x16x16 f16 -> f32), HSK = HSV = 256.
// _v64 variant of flash_attn_prefill_rdna4_rs.comp: the V scratch is pre-transposed per 32-kv tile by
// fa_dequant_q8_0_rdna4.comp ([head][tile][d][32 kv] f16, 16 KB contiguous per tile), so V is staged
// with plain uvec4 copies into 64-byte (+16 pad) LDS rows instead of a 16-store register transpose.
// Kill: GGML_VK_NO_FA_PREFILL_RDNA4_V64=1 (falls back to _rs).
//
// One workgroup owns one KV head and PQ = 16 query positions of all G q heads that share it
// (row tile t = q head kvh*G + t). Bc = 32 kv per tile, V staged transposed (sVt[d][kv]).
//
// QK computes S^T = K Q^T per wave (t, h): kv 16h .. 16h+15 x the 16 rows of tile t.
// Coopmat element layout, RADV 26.0 gfx1201 wave32, 16x16 (probed with perf-lab
// harness/wmma_peak --layout, see flash_attn_decode_q8r.comp):
//   A   (row m, col k): lane l holds m = l%16, k = 8*(l/16) + i, i = 0..7
//   Acc (row m, col n): lane l holds n = l%16, m = 8*(l/16) + i
// so accumulator element i of S^T is query row l%16, kv 16h + 8*(l/16) + i: exactly the P
// A-operand layout (row l%16, k = kv). Each lane owns one query row and 8 kv of it.
// Row max: 8 in-lane + xor 16 + the partner wave (the other kv half) through sMx.
// Row sum l: per-lane partial (8 kv), summed over lanes and the wave pair only at the end
// (a different f32 summation order from _vt; softmax and accumulation stay f32).
// A wrong layout assumption produces wrong attention output, which every FLASH_ATTN_EXT case
// with hsk=hsv=256, q8_0 K/V and N >= 64 in test-backend-ops catches against the CPU reference.
//
// PV: wave w owns row tiles (pt0, pt0+1) x hsv quarter pq (8 accumulators).
// Schedule per KV tile j, 2 barriers:
//   A(j): finish softmax(j) from registers -> sP, sA, sR; stage K(j+1), V(j), mask(j+1)
//   B(j): rescale O, PV(j) interleaved with S^T(j+1) (registers), mask + partial max -> sMx

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint WG = 384;   // 64 * G
layout(constant_id = 1) const uint G  = 6;     // q heads per KV head (even)
layout(constant_id = 2) const uint DIAG = 0;   // diagnostics only: 1 no QK MMA, 2 no PV MMA, 4 no global loads after tile 0, 8 no K frag LDS loads, 16 no V frag LDS loads, 32 no O rescale
// FPQ: number of independent S^T accumulator chains (1, 2 or 4). The QK product is a 16-deep
// dependent WMMA chain on one accumulator; splitting it (summed before the softmax) lets
// consecutive WMMAs issue without waiting on the previous result. Measured null (probe only:
// GGML_VK_FPQ_NS=2|4); default 1 = the original single chain.
layout(constant_id = 3) const uint NS = 1;
// FOV: 1 = lazy O rescale (the running max m_i only moves when a tile's max exceeds it by more
// than TAU, so P <= e^TAU and alpha == 1 on most tiles: no O rescale, no sA/sR traffic) plus
// loop-invariant per-thread prefetch offsets (one scalar tile offset per load instead of the
// clamped index math). 0 = the original schedule (GGML_VK_NO_FOV=1).
layout(constant_id = 4) const uint FOV = 1;
// FV2: 1 = base-2 softmax (log2e folded into the QK scale and the staged mask, exp2, no per-element
// multiply) and loop-invariant LDS staging addresses (one base per thread + immediate offsets).
// 0 = FOV schedule (GGML_VK_NO_FV2=1).
layout(constant_id = 5) const uint FV2 = 1;
// FV3: fewer VALU per KV tile. Default 16 (GGML_VK_NO_FV3=1 = 0 reverts to FV2; GGML_VK_FV3=<mask> picks a variant).
//   16 = prefetch addressing without per-load index registers (K/V rows contiguous: one base + immediate
//        offsets, no clamp on the unstaged tail), mask fetched and staged as half2 words
//        (one load, one packed log2e multiply, one select).
// Probes, measured null or worse in loop VALU/shuffle counts: 1 = KV loop unrolled by 2 (an odd tile
// count runs one extra fully masked tile, an exact no-op), 2 = P/V fragment loads after the O rescale,
// 4 / 8 = V / K+mask prefetch issued mid-B instead of in A, 32 = per-tile LDS addresses hoisted.
layout(constant_id = 6) const uint FV3 = 16;
const float LOG2E = 1.4426950408889634;
const float TAU = (FV2 != 0) ? 8.0 * LOG2E : 8.0;

const uint D   = 256;
const uint BC  = 32;
const uint PQ  = 16;
const uint NW  = WG / 32;                      // waves (2 per row tile)
const uint KSTR = 33;                          // uvec4 per staged K/Q row (32 + 1 pad: 132 dwords = 4 mod 64 banks, conflict-free A loads)
const uint VSTR = 5;                           // uvec4 per transposed V row (32 kv + 8 pad halves: 20 dwords, conflict-free B loads)
const uint MSTR = BC + 8;                      // halves per mask row (20 dwords)
const uint PSTR = 5;                           // uvec4 per P row (32 + 8 pad halves)
const uint NLK = (BC * 32 + WG - 1) / WG;      // K uvec4 loads per thread per tile
const uint NLV = (D * BC / 8 + WG - 1) / WG;   // V uvec4 loads per thread per tile
const uint NML = (PQ * BC / 2 + WG - 1) / WG;  // mask half2 loads per thread per tile

layout(push_constant) uniform parameter {
    uint N; uint KV; uint nhq;
    uint q_s1; uint q_s2; uint q_s3;           // floats
    uint k_s1; uint k_s2; uint k_s3;           // uvec4 (8 halves)
    uint v_s1; uint v_s2; uint v_s3;           // v_s1 = uvec4 per V tile (D * BC / 8), v_s2 per head
    uint m_s1; uint m_s3; uint has_mask; uint nem3;
    float scale;
} p;

layout(binding = 0) readonly buffer Q { vec4 data_q[]; };
// FOV_PIN (the _v64p build, used when FOV is on): volatile K/V/mask loads are not reorderable, so
// NIR does not sink the register prefetch from A(j) to the end of B(j), where it hid no latency.
#ifdef FOV_PIN
#define PFQ volatile readonly
#else
#define PFQ readonly
#endif
layout(binding = 1) PFQ buffer K { uvec4 data_k[]; };
layout(binding = 2) PFQ buffer V { uvec4 data_v[]; };
layout(binding = 3) PFQ buffer M { float16_t data_m[]; };
layout(binding = 3) PFQ buffer M32 { uint data_m32[]; };   // FV3: the same mask as half2 pairs
layout(binding = 4) writeonly buffer O { float data_o[]; };

shared uvec4 sK[BC * KSTR];                    // K tile (also Q staging and O staging)
shared uvec4 sVt[D * VSTR];                    // V tile transposed: [d][kv]
shared uvec4 sP[16 * G * PSTR];                // P, f16
shared vec4  sA[G * 64];                       // per row tile 16x16 broadcast of row factor
shared float16_t sM[PQ * MSTR];                  // mask tile
shared float sMx[NW * 16];                     // per-wave partial row max (later: partial l)
shared uvec4 sR4[(NW + 3) / 4];                // per-wave "row max changed" (wave w: sR4[w/4][w%4])

#define MATA  coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MATB  coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define MATC  coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint wave = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint t    = wave >> 1;               // QK/softmax: row tile = q head within the group
    const uint half_ = wave & 1;               // QK/softmax: kv half of the tile
    const uint pt0  = (wave >> 2) * 2;         // PV: row-tile pair
    const uint pq   = wave & 3;                // PV: hsv quarter (64 columns)
    const uint lr   = lane & 15;               // softmax: this lane's query row in tile t
    const uint lc   = 16 * half_ + 8 * (lane >> 4); // softmax: first of this lane's 8 kv columns

    const uint p0   = gl_WorkGroupID.x * PQ;
    const uint kvh  = gl_WorkGroupID.y;
    const uint iq3  = gl_WorkGroupID.z;
    const uint N = p.N, KV = p.KV;

    const uint k_base = iq3 * p.k_s3 + kvh * p.k_s2;
    const uint v_base = iq3 * p.v_s3 + kvh * p.v_s2;
    const uint m_base = (iq3 % p.nem3) * p.m_s3;
    const bool has_mask = p.has_mask != 0;

    // ---- Q: f32 global -> f16 LDS (2 row tiles per chunk) -> registers as B = Q^T
    MATB Qf[16];
    for (uint t0 = 0; t0 < G; t0 += 2) {
        [[unroll]] for (uint i = 0; i < (32 * 32 + WG - 1) / WG; ++i) {
            const uint e = tid + i * WG;
            if (e < 32 * 32) {
                const uint rr = e >> 5, c = e & 31;
                const uint tt = t0 + (rr >> 4), pos = p0 + (rr & 15);
                uvec4 w = uvec4(0);
                if (tt < G && pos < N) {
                    const uint qo = (iq3 * p.q_s3 + (kvh * G + tt) * p.q_s2 + pos * p.q_s1) / 4 + c * 2;
                    const vec4 a = data_q[qo], b = data_q[qo + 1];
                    w = uvec4(packFloat2x16(f16vec2(a.xy)), packFloat2x16(f16vec2(a.zw)),
                              packFloat2x16(f16vec2(b.xy)), packFloat2x16(f16vec2(b.zw)));
                }
                sK[rr * KSTR + c] = w;
            }
        }
        barrier();
        if (t >= t0 && t < t0 + 2) {
            [[unroll]] for (uint k = 0; k < 16; ++k) {
                coopMatLoad(Qf[k], sK, ((t - t0) * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
        barrier();
    }

    MATC Oacc[8];
    [[unroll]] for (uint i = 0; i < 8; ++i) Oacc[i] = MATC(0.0);

    float m_i = -1.0e30;                       // running max of row lr (same in all its lanes)
    float l_i = 0.0;                           // partial row sum over this lane's columns
    float sv[8];                               // scaled + masked S of the pending tile
    float mxo;                                 // this wave's partial max of the pending tile

    const uint nj = (KV + BC - 1) / BC;
    // FV3 bit 32: LDS addresses that do not change per tile, computed once (a handful of VALU per tile otherwise)
    const uint ixr_h = (wave ^ 1) * 16 + lr;               // sMx partner read
    const uint ixw_h = wave * 16 + lane;                   // sMx write
    const uint ipw_h = (t * 16 + lr) * PSTR + (lc >> 3);   // sP store
    const uint ism_h = lr * MSTR + lc;                     // sM read base
    const uint ixr = ((FV3 & 32) != 0) ? ixr_h : (wave ^ 1) * 16 + lr;
    const uint ixw = ((FV3 & 32) != 0) ? ixw_h : wave * 16 + lane;
    const uint ipw = ((FV3 & 32) != 0) ? ipw_h : (t * 16 + lr) * PSTR + (lc >> 3);
    const uint ism = ((FV3 & 32) != 0) ? ism_h : lr * MSTR + lc;

    const float sc_ = (FV2 != 0) ? p.scale * LOG2E : p.scale;
    // FV2: loop-invariant per-thread LDS staging bases
    const uint skb = (tid >> 5) * KSTR + (tid & 31);
    const uint svb = (tid >> 2) * VSTR + (tid & 3);
    const uint smb = (tid >> 4) * MSTR + (tid & 15) * 2;
    const int smcol = int((tid & 15) * 2);
    bool smrow[NML];
    [[unroll]] for (uint i = 0; i < NML; ++i) smrow[i] = p0 + ((tid + i * WG) >> 4) < N;

    uvec4 prk[NLK];
    uvec4 prv[NLV];
    float16_t pm[NML][2];
    uint pmw[NML];                             // FV3 AM: mask half2 words

// Prefetch loads are unconditional with clamped indices: a "x = 0; if (in range) x = load" form
// makes ACO wait for each load right away (the else-path write is a WAW on the load's VGPRs), which
// serialized the register prefetch in the base kernel. Out-of-range K/V rows read row KV-1 (finite;
// their columns are masked to -inf, so P = 0); out-of-range mask entries are fixed up at staging.
#define PREFETCH_K(j) if ((FV3 & 16) != 0) { \
        const uint ko_ = kb0 + min((j), nj - 1) * (BC * 32); \
        [[unroll]] for (uint i = 0; i < NLK; ++i) prk[i] = data_k[ko_ + i * WG]; \
    } else if (FOV != 0) { \
        const uint ko_ = min((j), nj - 1) * BC * p.k_s1; \
        [[unroll]] for (uint i = 0; i < NLK; ++i) prk[i] = data_k[kofs[i] + ko_]; \
    } else { \
        const uint kv0_ = (j) * BC; \
        [[unroll]] for (uint i = 0; i < NLK; ++i) { \
            const uint e = min(tid + i * WG, BC * 32 - 1); \
            const uint rr = min(kv0_ + (e >> 5), KV - 1), c = e & 31; \
            prk[i] = data_k[k_base + rr * p.k_s1 + c]; \
        } \
    }

#define STAGE_K { \
        [[unroll]] for (uint i = 0; i < NLK; ++i) { \
            const uint e = tid + i * WG; \
            if (e < BC * 32) { \
                if (FV2 != 0) sK[skb + i * (WG / 32) * KSTR] = prk[i]; \
                else { const uint rr = e >> 5, c = e & 31; sK[rr * KSTR + c] = prk[i]; } \
            } \
        } \
    }


#define PREFETCH_V(j) if ((FV3 & 16) != 0) { \
        const uint tb_ = v_base + min((j), nj - 1) * p.v_s1 + tid; \
        [[unroll]] for (uint i = 0; i < NLV; ++i) prv[i] = data_v[tb_ + i * WG]; \
    } else { \
        const uint tb_ = v_base + min((j), nj - 1) * p.v_s1; \
        [[unroll]] for (uint i = 0; i < NLV; ++i) { \
            prv[i] = data_v[tb_ + min(tid + i * WG, D * BC / 8 - 1)]; \
        } \
    }

#define PREFETCH_M(j) if ((FV3 & 16) != 0) { \
        const uint mo_ = has_mask ? min((j), nj - 1) * (BC / 2) : 0; \
        [[unroll]] for (uint i = 0; i < NML; ++i) pmw[i] = data_m32[mofs[i] + mo_]; \
    } else if (FOV != 0) { \
        const uint mo_ = min((j), nj - 1) * BC; \
        [[unroll]] for (uint i = 0; i < NML; ++i) { \
            pm[i][0] = data_m[has_mask ? mofs[i] + mo_     : 0]; \
            pm[i][1] = data_m[has_mask ? mofs[i] + mo_ + 1 : 0]; \
        } \
    } else { \
        const uint kv0_ = (j) * BC; \
        [[unroll]] for (uint i = 0; i < NML; ++i) { \
            const uint e = min(tid + i * WG, PQ * BC / 2 - 1); \
            const uint pos = min(p0 + (e >> 4), N - 1), c = kv0_ + (e & 15) * 2; \
            const uint mb = m_base + pos * p.m_s1; \
            pm[i][0] = data_m[has_mask ? mb + min(c,     KV - 1) : 0]; \
            pm[i][1] = data_m[has_mask ? mb + min(c + 1, KV - 1) : 0]; \
        } \
    }

#define STAGE_V { \
        [[unroll]] for (uint i = 0; i < NLV; ++i) { \
            const uint e = tid + i * WG; \
            if (e < D * BC / 8) { \
                if (FV2 != 0) sVt[svb + i * (WG / 4) * VSTR] = prv[i]; \
                else sVt[(e >> 2) * VSTR + (e & 3)] = prv[i]; \
            } \
        } \
    }

#define STAGE_M(j) { \
        if ((FV3 & 16) != 0) { \
            const int rem_ = int(KV) - int((j) * BC); \
            const uint wmask_ = has_mask ? 0xFFFFFFFFu : 0u; \
            const f16vec2 l2v_ = f16vec2(float16_t(LOG2E)); \
            [[unroll]] for (uint i = 0; i < NML; ++i) { \
                const uint e = tid + i * WG; \
                if (e < PQ * BC / 2) { \
                    const uint sm_ = smb + i * (WG / 16) * MSTR; \
                    uint w_ = packFloat2x16(unpackFloat2x16(pmw[i] & wmask_) * l2v_); \
                    if (rem_ >= int(BC) || (rem_ & 1) == 0) { \
                        w_ = (smrow[i] && smcol < rem_) ? w_ : 0xFC00FC00u; \
                    } else { \
                        w_ = !smrow[i] || smcol >= rem_ ? 0xFC00FC00u : (smcol + 1 < rem_ ? w_ : ((w_ & 0xFFFFu) | 0xFC000000u)); \
                    } \
                    const f16vec2 r_ = unpackFloat2x16(w_); \
                    sM[sm_] = r_.x; sM[sm_ + 1] = r_.y; \
                } \
            } \
        } else if (FV2 != 0) { \
            const int rem_ = int(KV) - int((j) * BC); \
            const float16_t l2_ = float16_t(LOG2E); \
            const float16_t ninf = float16_t(-1.0/0.0); \
            [[unroll]] for (uint i = 0; i < NML; ++i) { \
                const uint e = tid + i * WG; \
                if (e < PQ * BC / 2) { \
                    const uint sm_ = smb + i * (WG / 16) * MSTR; \
                    sM[sm_]     = (smrow[i] && smcol < rem_)     ? (has_mask ? pm[i][0] * l2_ : float16_t(0.0)) : ninf; \
                    sM[sm_ + 1] = (smrow[i] && smcol + 1 < rem_) ? (has_mask ? pm[i][1] * l2_ : float16_t(0.0)) : ninf; \
                } \
            } \
        } else \
        [[unroll]] for (uint i = 0; i < NML; ++i) { \
            const uint e = tid + i * WG; \
            if (e < PQ * BC / 2) { \
                const uint c = (j) * BC + (e & 15) * 2; \
                const bool prow = p0 + (e >> 4) < N; \
                const float16_t ninf = float16_t(-1.0/0.0); \
                sM[(e >> 4) * MSTR + (e & 15) * 2]     = (prow && c     < KV) ? (has_mask ? pm[i][0] : float16_t(0.0)) : ninf; \
                sM[(e >> 4) * MSTR + (e & 15) * 2 + 1] = (prow && c + 1 < KV) ? (has_mask ? pm[i][1] : float16_t(0.0)) : ninf; \
            } \
        } \
    }

    // S^T accumulator -> scaled, masked sv[]; partial row max -> mxo and sMx
#define S_FINISH(Sacc) { \
        mxo = -1.0/0.0; \
        [[unroll]] for (uint i = 0; i < 8; ++i) { \
            sv[i] = Sacc[i] * sc_ + float(sM[ism + i]); \
            mxo = max(mxo, sv[i]); \
        } \
        mxo = max(mxo, subgroupShuffleXor(mxo, 16)); \
        if (lane < 16) sMx[ixw] = mxo; \
    }

    // FOV: per-thread loop-invariant prefetch offsets. The tile index is clamped to the last tile;
    // rows past KV inside the last tile read the next head's rows (or 0 past the binding: robust
    // buffer descriptors), always finite, and their columns are masked to -inf at staging.
    uint kofs[NLK];
    uint mofs[NML];
    [[unroll]] for (uint i = 0; i < NLK; ++i) {
        const uint e = min(tid + i * WG, BC * 32 - 1);
        kofs[i] = k_base + (e >> 5) * p.k_s1 + (e & 31);
    }
    [[unroll]] for (uint i = 0; i < NML; ++i) {
        const uint e = min(tid + i * WG, PQ * BC / 2 - 1);
        mofs[i] = m_base + min(p0 + (e >> 4), N - 1) * p.m_s1 + (e & 15) * 2;
    }

    const uint kb0 = k_base + tid;   // FV3 AM: K scratch rows are 32 uvec4 (HSK / 8) and contiguous, so row*32 + c == e
    if ((FV3 & 16) != 0) {
        [[unroll]] for (uint i = 0; i < NML; ++i) {
            mofs[i] = has_mask ? mofs[i] >> 1 : 0;
        }
    }

    PREFETCH_K(0)
    PREFETCH_M(0)
    STAGE_K
    STAGE_M(0)
    PREFETCH_K(1)
    PREFETCH_V(0)
    PREFETCH_M(1)
    barrier();
    {
        MATC Sc[NS];
        [[unroll]] for (uint c = 0; c < NS; ++c) Sc[c] = MATC(0.0);
        [[unroll]] for (uint k = 0; k < 16; ++k) {
            MATA Kf;
            coopMatLoad(Kf, sK, (half_ * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutRowMajor);
            Sc[k % NS] = coopMatMulAdd(Kf, Qf[k], Sc[k % NS]);
        }
        MATC Sacc = Sc[0];
        [[unroll]] for (uint c = 1; c < NS; ++c) Sacc = Sacc + Sc[c];
        S_FINISH(Sacc)
    }
    barrier();

    const uint FV3U = ((FV3 & 1) != 0) ? 2 : 1;
    const uint njl = (nj + FV3U - 1) / FV3U * FV3U;
    for (uint j0 = 0; j0 < njl; j0 += FV3U) {
      [[unroll]] for (uint u = 0; u < FV3U; ++u) {
        const uint j = j0 + u;
        // ---- A(j): finish online softmax of tile j in registers, f32
        {
            const float m_c = max(m_i, max(mxo, sMx[ixr]));
            // FOV: both waves of a row pair see the same m_i and tile max, so they agree on m_new
            const float m_new = (FOV != 0 && m_c <= m_i + TAU) ? m_i : m_c;
            const float alpha = (FV2 != 0) ? exp2(m_i - m_new) : exp(m_i - m_new);
            float rs = 0.0;
            f16vec2 ph[4];
            [[unroll]] for (uint e = 0; e < 4; ++e) {
                const float e0 = (FV2 != 0) ? exp2(sv[2 * e] - m_new) : exp(sv[2 * e] - m_new);
                const float e1 = (FV2 != 0) ? exp2(sv[2 * e + 1] - m_new) : exp(sv[2 * e + 1] - m_new);
                rs += e0 + e1;
                ph[e] = f16vec2(e0, e1);
            }
            l_i = l_i * alpha + rs;
            m_i = m_new;
            sP[ipw] = uvec4(packFloat2x16(ph[0]), packFloat2x16(ph[1]),
                                                         packFloat2x16(ph[2]), packFloat2x16(ph[3]));
            const bool resc = subgroupAny(alpha != 1.0);
            // FOV: alpha is the same in both waves of the pair; sA is only read when resc is set
            if (half_ == 0 && lane < 16 && (FOV == 0 || resc)) {
                [[unroll]] for (uint q = 0; q < 4; ++q) sA[t * 64 + lr * 4 + q] = vec4(alpha);
            }
            if (lane == 0) sR4[wave >> 2][wave & 3] = resc ? 1u : 0u;
        }
        STAGE_K
        STAGE_V
        STAGE_M(j + 1)
        if ((DIAG & 4) == 0) {
            if ((FV3 & 8) == 0) { PREFETCH_K(j + 2) }
            if ((FV3 & 4) == 0) { PREFETCH_V(j + 1) }
            if ((FV3 & 8) == 0) { PREFETCH_M(j + 2) }
        }
        barrier();

        // ---- B(j): rescale, PV(j) for row tiles (pt0, pt0+1) x hsv quarter pq, and S^T(j+1)
        // FOV: one 16-byte sR read for both row tiles, issued together with the kk = 0 P/V fragment
        // loads so the rescale branch waits only for the flags, not for a serial LDS round trip each.
        MATA Pa0, Pa1;
        MATB Va[4];
        uvec4 rf = uvec4(0);
        if (FOV != 0) {
            rf = sR4[pt0 >> 1];                // waves 2 pt0 .. 2 pt0 + 3 (pt0 even)
          if ((FV3 & 2) == 0) {
            coopMatLoad(Pa0, sP, (pt0 * 16) * PSTR, PSTR, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(Pa1, sP, (pt0 * 16 + 16) * PSTR, PSTR, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                coopMatLoad(Va[i], sVt, (pq * 64 + i * 16) * VSTR, VSTR, gl_CooperativeMatrixLayoutColumnMajor);
            }
          }
        }
        [[unroll]] for (uint r = 0; r < 2; ++r) {
            const uint tr = pt0 + r;
            const bool rs_ = FOV != 0 ? (r == 0 ? (rf.x | rf.y) : (rf.z | rf.w)) != 0
                                      : (sR4[(2 * tr) >> 2][(2 * tr) & 3] | sR4[(2 * tr + 1) >> 2][(2 * tr + 1) & 3]) != 0;
            if ((DIAG & 32) == 0 && rs_) {
                MATC Am;
                coopMatLoad(Am, sA, tr * 64, 4, gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint i = 0; i < 4; ++i) Oacc[r * 4 + i] = Oacc[r * 4 + i] * Am;
            }
        }
        if (FOV != 0 && (FV3 & 2) != 0) {
            coopMatLoad(Pa0, sP, (pt0 * 16) * PSTR, PSTR, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(Pa1, sP, (pt0 * 16 + 16) * PSTR, PSTR, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                coopMatLoad(Va[i], sVt, (pq * 64 + i * 16) * VSTR, VSTR, gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
        {
            MATC Sc[NS];
            [[unroll]] for (uint c = 0; c < NS; ++c) Sc[c] = MATC(0.0);
            [[unroll]] for (uint kk = 0; kk < 2; ++kk) {
                MATA Pf0, Pf1;
                if (FOV != 0 && kk == 0) {
                    Pf0 = Pa0; Pf1 = Pa1;
                } else {
                    coopMatLoad(Pf0, sP, (pt0 * 16) * PSTR + kk * 2, PSTR, gl_CooperativeMatrixLayoutRowMajor);
                    coopMatLoad(Pf1, sP, (pt0 * 16 + 16) * PSTR + kk * 2, PSTR, gl_CooperativeMatrixLayoutRowMajor);
                }
                [[unroll]] for (uint i = 0; i < 4; ++i) {
                    MATB Vf = MATB(float16_t(0.001));
                    if (FOV != 0 && kk == 0) Vf = Va[i];
                    else if ((DIAG & 16) == 0) coopMatLoad(Vf, sVt, (pq * 64 + i * 16) * VSTR + kk * 2, VSTR, gl_CooperativeMatrixLayoutColumnMajor);
                    if ((DIAG & 2) == 0) {
                        Oacc[i]     = coopMatMulAdd(Pf0, Vf, Oacc[i]);
                        Oacc[4 + i] = coopMatMulAdd(Pf1, Vf, Oacc[4 + i]);
                    }
                    [[unroll]] for (uint h = 0; h < 2; ++h) {
                        const uint k = kk * 8 + i * 2 + h;
                        MATA Kf = MATA(float16_t(0.001));
                        if ((DIAG & 8) == 0) coopMatLoad(Kf, sK, (half_ * 16) * KSTR + k * 2, KSTR, gl_CooperativeMatrixLayoutRowMajor);
                        if ((DIAG & 1) == 0) Sc[k % NS] = coopMatMulAdd(Kf, Qf[k], Sc[k % NS]);
                    }
                }
                if (kk == 0 && (DIAG & 4) == 0) {
                    if ((FV3 & 4) != 0) { PREFETCH_V(j + 1) }
                    if ((FV3 & 8) != 0) { PREFETCH_K(j + 2) PREFETCH_M(j + 2) }
                }
            }
            MATC Sacc = Sc[0];
            [[unroll]] for (uint c = 1; c < NS; ++c) Sacc = Sacc + Sc[c];
            S_FINISH(Sacc)
        }
        barrier();
      }
    }

    // ---- row sums: lanes l, l^16, then the wave pair; 1/l -> sA
    {
        const float rs = l_i + subgroupShuffleXor(l_i, 16);
        if (lane < 16) sMx[wave * 16 + lane] = rs;
    }
    barrier();
    if (half_ == 0 && lane < 16) {
        const float L = sMx[wave * 16 + lane] + sMx[(wave + 1) * 16 + lane];
        [[unroll]] for (uint q = 0; q < 4; ++q) sA[t * 64 + lane * 4 + q] = vec4(L > 0.0 ? 1.0 / L : 0.0);
    }
    barrier();

    // ---- normalize and store
    const uint o_row = p.nhq * D;
    [[unroll]] for (uint r = 0; r < 2; ++r) {
        MATC Lm;
        coopMatLoad(Lm, sA, (pt0 + r) * 64, 4, gl_CooperativeMatrixLayoutRowMajor);
        const uint head = kvh * G + pt0 + r;
        const uint o_base = (iq3 * N + p0) * o_row + head * D + pq * 64;
        if (p0 + PQ <= N) {
            [[unroll]] for (uint i = r * 4; i < r * 4 + 4; ++i) {
                Oacc[i] = Oacc[i] * Lm;
                coopMatStore(Oacc[i], data_o, o_base + (i & 3) * 16, o_row, gl_CooperativeMatrixLayoutRowMajor);
            }
        } else {
            // partial position block: stage each 16x16 through a per-wave slot in sK (free now)
            const uint slot = wave * 64;       // 64 uvec4 = 256 floats per wave
            [[unroll]] for (uint i = r * 4; i < r * 4 + 4; ++i) {
                Oacc[i] = Oacc[i] * Lm;
                coopMatStore(Oacc[i], sK, slot, 4, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                for (uint e = lane; e < 256; e += 32) {
                    const uint rr = e >> 4, c = e & 15;
                    if (p0 + rr < N) {
                        data_o[o_base + rr * o_row + (i & 3) * 16 + c] = uintBitsToFloat(sK[slot + rr * 4 + (c >> 2)][c & 3]);
                    }
                }
                subgroupBarrier();
            }
        }
    }
}
