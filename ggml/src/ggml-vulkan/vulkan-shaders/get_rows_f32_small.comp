#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

// GET_ROWS fast path for ne00 == 1, f32 -> f32: one thread per gathered element,
// flattened over (ne10, ne11*ne12). Same index math as get_rows.comp.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    const uint n = p.ne10 * p.ne11 * p.ne12;
    if (idx >= n) {
        return;
    }
    const uint i10 = idx % p.ne10;
    const uint gz  = idx / p.ne10;
    const uint i11 = gz / p.ne12;
    const uint i12 = gz % p.ne12;

    const uint i01 = data_b[get_boffset() + i10*p.nb10 + i11*p.nb11 + i12*p.nb12];
    const uint a_offset = get_aoffset() + i01*p.nb01 + i11*p.nb02 + i12*p.nb03;
    const uint d_offset = get_doffset() + i10*p.nb21 + i11*p.nb22 + i12*p.nb23;
    data_d[d_offset] = D_TYPE(data_a[a_offset]);
}
